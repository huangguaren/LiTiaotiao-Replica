# LiTiaotiao 复刻版 · 环境变量示例
# 复制为 .env 后修改；全部均有安全默认值，留空即可直接运行。

# 服务监听地址与端口
LTT_HOST=127.0.0.1
LTT_PORT=8000

# SQLite 数据库文件路径
LTT_DB_PATH=data/litiaotiao.db

# 日志文件路径
LTT_LOG_PATH=data/litiaotiao.log

# 社区规则库目录（用于反查 包名 ↔ 应用名）
LTT_CUSTOM_RULES_DIR=D:/software/LiTiaotiao-main/LiTiaotiao-Custom-Rules-main/LiTiaotiao-Custom-Rules-main

# 种子规则文件（AllRules.json）
LTT_SEED_ALL_RULES=D:/software/LiTiaotiao-main/LiTiaotiao-Custom-Rules-main/LiTiaotiao-Custom-Rules-main/AllRules.json

# 调试模式（True 时日志级别为 DEBUG）
LTT_DEBUG=False
